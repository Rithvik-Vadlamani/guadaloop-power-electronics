(version 1)
(rule "Assembly courtyard spacing"
 (constraint courtyard_clearance (min 0.25mm)))
(rule "Ground plane remains unrouted"
 (condition "A.Type == 'Track' && A.Layer == 'In1.Cu'")
 (constraint disallow track))
(rule "Bus plane remains unrouted"
 (condition "A.Type == 'Track' && A.Layer == 'In2.Cu'")
 (constraint disallow track))
